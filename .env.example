# Copie a .env (NO versionar) o exporte las variables en su shell.
# Genere un secreto con:  openssl rand -base64 32
PULSEPASS_JWT_SECRET_BASE64=
PULSEPASS_JWT_ISSUER=pulsepass-api

# Solo para el perfil local-seed (cuentas ADMIN/STAFF de demostracion), minimo 12 caracteres
PULSEPASS_SEED_ADMIN_PASSWORD=
PULSEPASS_SEED_STAFF_PASSWORD=

# Origenes CORS permitidos, separados por coma y SIN comodines (vacio = CORS desactivado)
PULSEPASS_CORS_ALLOWED_ORIGINS=

# Solo para el perfil legacy-activation (activar UN usuario preexistente sin credenciales)
PULSEPASS_ACTIVATE_USERNAME=
PULSEPASS_ACTIVATE_PASSWORD=
